<?xml version="1.0"?>
<ruleset name="Klaro">
	<description>PHPCS rules for the Klaro theme: WordPress standard plus PHP 7.4+ compatibility.</description>

	<file>.</file>
	<exclude-pattern>/vendor/*</exclude-pattern>
	<exclude-pattern>/node_modules/*</exclude-pattern>

	<arg name="extensions" value="php"/>
	<arg value="sp"/>

	<!-- Warnings are reported but do not fail the build; errors do. -->
	<config name="ignore_warnings_on_exit" value="1"/>

	<config name="minimum_wp_version" value="6.6"/>
	<config name="testVersion" value="7.4-"/>

	<rule ref="WordPress">
		<!--
		Documentation style only (inline comment punctuation, @param tags,
		file comment spacing). These do not affect runtime behavior or
		directory review and are tracked separately in issue #23.
		-->
		<exclude name="Squiz.Commenting.InlineComment"/>
		<exclude name="Squiz.Commenting.FunctionComment"/>
		<exclude name="Squiz.Commenting.FileComment"/>
		<exclude name="Generic.Commenting.DocComment"/>
	</rule>

	<rule ref="PHPCompatibilityWP"/>

	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="klaro"/>
			</property>
		</properties>
	</rule>

	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<properties>
			<property name="prefixes" type="array">
				<element value="klaro"/>
			</property>
		</properties>
		<!--
		WooCommerce overrides must fire WooCommerce's own hooks and keep
		its variable names so extensions keep working.
		-->
		<exclude-pattern>/woocommerce/*</exclude-pattern>
	</rule>

	<!--
	Template files are loaded inside load_template(), so their variables
	are function-scoped, not globals.
	-->
	<rule ref="WordPress.NamingConventions.PrefixAllGlobals.NonPrefixedVariableFound">
		<exclude-pattern>/template-parts/*</exclude-pattern>
		<exclude-pattern>/searchform\.php$</exclude-pattern>
	</rule>

	<!--
	wc_kses_notice() is WooCommerce's own sanitizer for notice markup; the
	notice template overrides use it exactly as WooCommerce core does.
	-->
	<rule ref="WordPress.Security.EscapeOutput">
		<properties>
			<property name="customEscapingFunctions" type="array">
				<element value="wc_kses_notice"/>
			</property>
		</properties>
	</rule>
</ruleset>
